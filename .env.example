# Copy to .env and fill in. Never put passwords, client secrets or access keys here:
# CyberArk credentials live in AWS Secrets Manager, AWS credentials come from your SSO session.

# ---- AWS account (from your sandbox) ----
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=058264514744
PROJECT=cyberark-engineer

# ---- Knowledge base source bucket (created by scripts/setup_kb.py) ----
# The old bucket cyberark-ai-agent-knowledge-base no longer exists; a new one is created.
KB_BUCKET=cyberark-engineer-kb-058264514744
KB_PRODUCT_PREFIX=product/
KB_OPS_PREFIX=internal/v0.1/bau/

# ---- Bedrock models: use inference-profile IDs enabled in Sydney ----
# List them with: aws bedrock list-inference-profiles --region ap-southeast-2 \
#   --query "inferenceProfileSummaries[?contains(inferenceProfileId,'claude')].inferenceProfileId"
MODEL_SUPERVISOR=REPLACE_with_claude_sonnet_inference_profile_id
MODEL_FAST=REPLACE_with_claude_haiku_inference_profile_id
MODEL_DEEP=REPLACE_with_claude_opus_inference_profile_id

# ---- CyberArk environments (troubleshooting targets) ----
# Each environment's credentials live in its own Secrets Manager secret (create them in CloudShell,
# never in this file). Privilege Cloud secrets: {"client_id": "...", "client_secret": "..."} for an
# ISPSS service user. On-prem secret: {"username": "...", "password": "...", "auth_method": "CyberArk"}.

# Privilege Cloud pre-production
PC_PREPROD_PVWA_URL=https://YOUR_PREPROD_SUBDOMAIN.privilegecloud.cyberark.cloud/PasswordVault
PC_PREPROD_TOKEN_URL=https://YOUR_PREPROD_TENANT_ID.id.cyberark.cloud/oauth2/platformtoken
PC_PREPROD_SECRET_NAME=cyberark-engineer/pc-preprod

# Privilege Cloud production
PC_PROD_PVWA_URL=https://YOUR_PROD_SUBDOMAIN.privilegecloud.cyberark.cloud/PasswordVault
PC_PROD_TOKEN_URL=https://YOUR_PROD_TENANT_ID.id.cyberark.cloud/oauth2/platformtoken
PC_PROD_SECRET_NAME=cyberark-engineer/pc-prod

# On-premises PAM (Primary Vault + DR Vault), reached through PVWA over VPN / Direct Connect
ONPREM_PVWA_URL=https://pvwa.YOUR_DOMAIN.internal/PasswordVault
ONPREM_SECRET_NAME=cyberark-engineer/onprem
# Private subnets with a route to on-prem AND a NAT gateway (Lambda also calls Privilege Cloud,
# Secrets Manager and CloudWatch). Comma-separated. Leave empty until connectivity exists.
PAM_LAMBDA_SUBNET_IDS=
PAM_LAMBDA_SECURITY_GROUP_IDS=
# Optional: S3 URI of your internal CA bundle (PEM) if PVWA uses a private certificate.
ONPREM_CA_BUNDLE_S3=

# Troubleshooting only: service-request tools (new safes, onboarding) stay off.
ENABLE_SERVICE_REQUESTS=false

# ---- ITSM (optional for phase 1) ----
ITSM_BASE_URL=https://YOUR_INSTANCE.service-now.com

# ---- Filled in automatically by the setup scripts (outputs/*.json) ----
GATEWAY_MCP_URL=
MEMORY_ID=
KB_PRODUCT_ID=
KB_OPS_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
